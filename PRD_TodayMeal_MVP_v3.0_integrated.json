  "meta": {
    "project_name": "OneMealToday (오늘한끼)",
    "version": "3.0.0",
    "last_updated": "2026-01-06",
    "platforms": ["mobile", "tablet", "desktop"],
    "tech_stack": {
      "frontend": "Next.js 14 (App Router)",
      "language": "TypeScript",
      "styling": "Tailwind CSS",
      "state": "Zustand",
      "animation": "Framer Motion",
      "ui_components": "Lucide React Icons"
    },
    "core_value": "오늘 저녁 뭐 먹지? 그럼 아침엔 이거!"
  },

  "design_system": {
