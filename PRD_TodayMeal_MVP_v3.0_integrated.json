  "api_contracts": {
    "note": "Currently using mock data - API contracts for future backend integration",
    "endpoints": {
      "auth": {
        "POST /auth/login": "Login with provider",
        "POST /auth/logout": "Logout user",
        "GET /auth/me": "Get current user"
