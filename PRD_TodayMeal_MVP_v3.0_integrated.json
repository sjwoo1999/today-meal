          "50": "#FFFBEB",
          "400": "#FBBF24",
          "500": "#F59E0B"
        }
      },
      "semantic": {
        "success": "#22C55E",
        "warning": "#FFB74D",
        "error": "#E7AAAA",
        "info": "#5995B7"
      },
      "hanki": {
