  "user_flows": {
    "UF-001": {
      "name": "Onboarding Flow",
      "trigger": "First app launch or new user registration",
      "steps": [
        {
          "step": 1,
          "screen": "SplashScreen",
          "action": "Display app logo and check auth status",
          "next": "LoginPage (if not authenticated) | HomePage (if authenticated)"
        },
        {
          "step": 2,
          "screen": "LoginPage",
          "action": "User selects login method (Kakao/Apple/Google/Email)",
          "next": "OnboardingPage (if new user) | HomePage (if returning user)"
        },
        {
          "step": 3,
          "screen": "OnboardingPage - Step 1",
          "action": "User selects goal (lose/maintain/gain weight)",
          "next": "OnboardingPage - Step 2"
        },
        {
          "step": 4,
          "screen": "OnboardingPage - Step 2",
          "action": "User enters body info (height, weight, age, gender)",
          "next": "OnboardingPage - Step 3"
        },
        {
          "step": 5,
          "screen": "OnboardingPage - Step 3",
          "action": "User selects activity level",
          "next": "OnboardingPage - Step 4"
        },
        {
          "step": 6,
          "screen": "OnboardingPage - Step 4",
          "action": "User selects food preferences and allergies",
          "next": "HomePage"
        }
      ],
      "states": {
        "loading": "Checking authentication status",
        "error": "Network failure - show retry button",
        "success": "Navigate to next step"
      }
    },
    "UF-002": {
      "name": "Meal Recording Flow",
      "trigger": "User taps record button or camera icon",
      "steps": [
        {
          "step": 1,
          "screen": "RecordPage",
          "action": "User selects Camera or Gallery option",
          "next": "Camera capture or Gallery picker"
        },
        {
          "step": 2,
          "screen": "ImageCapture",
          "action": "User captures food photo",
          "next": "FoodDetectionModal"
        },
        {
          "step": 3,
          "screen": "FoodDetectionModal",
          "action": "AI analyzes image and detects food",
          "next": "NutritionEditModal"
        },
        {
          "step": 4,
          "screen": "NutritionEditModal",
          "action": "User reviews and adjusts nutrition values",
          "next": "MealTypeSelector"
        },
        {
          "step": 5,
          "screen": "MealTypeSelector",
          "action": "User selects meal type (breakfast/lunch/dinner/snack)",
          "next": "ConfirmationScreen"
        },
        {
          "step": 6,
          "screen": "ConfirmationScreen",
          "action": "User confirms and saves meal record",
          "next": "SuccessAnimation -> Dashboard"
        }
      ],
      "states": {
        "loading": "AI analyzing image (2-3 seconds)",
        "error": "Detection failed - show manual input option",
        "empty": "No recent meals recorded",
        "success": "XP awarded animation (+10-15 XP)"
      }
    },
    "UF-003": {
      "name": "Feed Interaction Flow",
      "trigger": "User navigates to Feed tab",
      "steps": [
        {
          "step": 1,
          "screen": "FeedPage",
          "action": "Display story bar and post feed",
          "next": "PostDetail (on post tap) | StoryViewer (on story tap)"
        },
        {
          "step": 2,
          "screen": "PostDetail",
          "action": "User views post and interacts (like/comment/share)",
          "next": "CommentSection (on comment tap)"
        },
        {
          "step": 3,
          "screen": "CommentSection",
          "action": "User adds comment or replies",
          "next": "PostDetail"
        },
        {
          "step": 4,
          "screen": "AuthorProfile",
          "action": "User taps author name to view profile",
          "next": "UserProfilePage"
        },
        {
          "step": 5,
          "screen": "UserProfilePage",
          "action": "User views profile and can follow/unfollow",
          "next": "FeedPage (back)"
        }
      ],
      "states": {
        "loading": "Feed skeleton animation",
        "empty": "팔로우하고 피드를 채워보세요",
        "error": "Load failed - show retry button"
      }
    },
    "UF-004": {
      "name": "Challenge Participation Flow",
      "trigger": "User navigates to Squad tab and selects challenge",
      "steps": [
        {
          "step": 1,
          "screen": "SquadListPage",
          "action": "User browses challenges in 'Challenges' tab",
          "next": "ChallengeDetailPage"
        },
        {
          "step": 2,
          "screen": "ChallengeDetailPage",
          "action": "User views challenge details and participants",
          "next": "JoinConfirmation (on join tap)"
        },
        {
          "step": 3,
          "screen": "JoinConfirmation",
          "action": "User confirms joining the challenge",
          "next": "ChallengeDetailPage (as participant)"
        },
        {
          "step": 4,
          "screen": "ChallengeDetailPage",
          "action": "User records meals to progress in challenge",
          "next": "RecordPage"
        },
        {
          "step": 5,
          "screen": "LeaderboardView",
          "action": "User views challenge leaderboard",
          "next": "ChallengeDetailPage"
        },
        {
          "step": 6,
          "screen": "RewardsScreen",
          "action": "Challenge ends - user receives rewards",
          "next": "ProfilePage (badges)"
        }
      ],
      "states": {
        "loading": "Challenge data loading",
        "empty": "새로운 챌린지가 곧 시작됩니다",
        "locked": "Not eligible (requirements not met)",
        "completed": "Show rewards and final rank"
      }
    },
    "UF-005": {
      "name": "AI Coach Interaction Flow",
      "trigger": "User taps Coach tab or Hanki widget",
      "steps": [
        {
          "step": 1,
          "screen": "CoachPage",
          "action": "Display chat interface with Hanki",
          "next": "ChatInput"
        },
        {
          "step": 2,
          "screen": "ChatInput",
          "action": "User types question or selects quick reply",
          "next": "AIProcessing"
        },
        {
          "step": 3,
          "screen": "AIProcessing",
          "action": "AI generates response with recommendations",
          "next": "ChatResponse"
        },
        {
          "step": 4,
          "screen": "ChatResponse",
          "action": "User reads response and taps action button if present",
          "next": "ActionTarget (RecordPage, NearbyPage, etc.)"
        }
      ],
      "states": {
        "loading": "AI thinking animation (typing indicator)",
        "error": "Response failed - show retry button",
        "suggestion": "Quick action buttons displayed"
      }
    },
    "UF-006": {
      "name": "Points & Shop Flow",
      "trigger": "User navigates to Shop tab",
      "steps": [
        {
          "step": 1,
          "screen": "PointShopPage",
          "action": "Display points balance and available items",
          "next": "ItemDetail (on item tap)"
        },
        {
          "step": 2,
          "screen": "ItemDetail",
          "action": "User views item details and price",
          "next": "PurchaseConfirm (on buy tap)"
        },
        {
          "step": 3,
          "screen": "PurchaseConfirm",
          "action": "User confirms purchase",
          "next": "PurchaseSuccess | InsufficientPoints"
        },
        {
          "step": 4,
          "screen": "PurchaseSuccess",
          "action": "Display success animation and item added to inventory",
          "next": "InventoryPage"
        },
        {
          "step": 5,
          "screen": "InventoryPage",
          "action": "User views and equips purchased items",
          "next": "PointShopPage (back)"
        }
      ],
      "states": {
        "loading": "Shop items loading",
        "empty": "상품 준비 중입니다",
        "insufficient": "Not enough points - show earn points CTA",
        "success": "Purchase complete animation"
      }
    },
    "UF-007": {
      "name": "Squad Management Flow",
      "trigger": "User navigates to Squad tab",
      "steps": [
        {
          "step": 1,
          "screen": "SquadListPage",
          "action": "Display my squads and discover section",
          "next": "SquadDetailPage (on squad tap) | CreateSquadModal (on create tap)"
        },
        {
          "step": 2,
          "screen": "CreateSquadModal",
          "action": "User fills squad info (name, description, settings)",
          "next": "SquadDetailPage (new squad)"
        },
        {
          "step": 3,
          "screen": "SquadDetailPage",
          "action": "User views squad details, members, challenges",
          "next": "CreateChallengeModal (if owner)"
        },
        {
          "step": 4,
          "screen": "CreateChallengeModal",
          "action": "Owner creates new challenge for squad",
          "next": "ChallengeDetailPage"
        },
        {
          "step": 5,
          "screen": "MemberManagement",
          "action": "Owner manages squad members",
          "next": "SquadDetailPage"
        }
      ],
      "states": {
        "loading": "Squad data loading",
        "empty": "아직 참여한 스쿼드가 없어요",
        "pending": "Join request sent - waiting for approval",
        "owner": "Management options visible"
      }
    }
  },

  "service_flows": {
    "SF-001": {
      "name": "Point Transaction Service",
      "description": "Handles all point earning, spending, and balance management",
      "types": {
        "PointTransaction": {
          "id": "string",
          "userId": "string",
          "type": "earn | spend | expire | refund",
          "amount": "number",
          "source": "meal_record | challenge | streak | purchase | referral",
          "timestamp": "Date",
          "metadata": "Record<string, any>"
        }
      },
      "state_machine": {
        "states": ["idle", "processing", "success", "failed", "rollback"],
        "transitions": {
          "idle -> processing": "initiate transaction",
          "processing -> success": "transaction complete",
          "processing -> failed": "validation error or insufficient balance",
          "failed -> rollback": "revert changes",
          "rollback -> idle": "cleanup complete"
        }
      },
      "earn_rates": {
        "meal_record": 10,
        "reverse_plan_set": 10,
        "reverse_plan_complete": 30,
        "daily_goal": 25,
        "weekly_goal": 100,
        "streak_7_days": 50,
        "streak_30_days": 200
      }
    },
    "SF-002": {
      "name": "Feed Distribution Service",
      "description": "Manages feed algorithm and content distribution",
      "algorithm": {
        "inputs": {
          "userPreferences": "UserProfile",
          "followingList": "string[]",
          "interactionHistory": "Interaction[]",
          "contentFreshness": "number"
        },
        "weights": {
          "relevance": 0.3,
          "freshness": 0.25,
          "engagement": 0.25,
          "following": 0.2
        },
        "output": "ScoredPost[]"
      },
      "state_machine": {
        "states": ["loading", "loaded", "refreshing", "loadingMore", "error"],
        "transitions": {
          "loading -> loaded": "initial fetch complete",
          "loaded -> refreshing": "pull to refresh",
          "refreshing -> loaded": "refresh complete",
          "loaded -> loadingMore": "scroll to bottom",
          "loadingMore -> loaded": "more posts loaded",
          "any -> error": "fetch failed"
        }
      }
    },
    "SF-003": {
      "name": "AI Moderation Service",
      "description": "Content moderation and food verification",
      "types": {
        "ModerationResult": {
          "postId": "string",
          "status": "approved | flagged | rejected",
          "flags": "ModerationFlag[]",
          "confidence": "number",
          "humanReviewRequired": "boolean"
        }
      },
      "pipeline": [
        "input",
        "content_analysis",
        "food_verification",
        "community_guidelines_check",
        "auto_decision | human_queue"
      ],
      "thresholds": {
        "auto_approve": 0.95,
        "human_review": 0.7,
        "auto_reject": 0.3
      }
    },
    "SF-004": {
      "name": "Challenge Lifecycle Service",
      "description": "Manages challenge states and lifecycle events",
      "state_machine": {
        "states": [
          "draft",
          "upcoming",
          "active",
          "calculating",
          "completed",
          "archived"
        ],
        "transitions": {
          "draft -> upcoming": "owner publishes challenge",
          "upcoming -> active": "start_date reached",
          "active -> calculating": "end_date reached",
          "calculating -> completed": "results computed and rewards distributed",
          "completed -> archived": "30 days after completion"
        }
      },
      "lifecycle_events": {
        "on_join": "Add participant, initialize progress",
        "on_progress": "Update leaderboard, check achievements",
        "on_complete": "Calculate final rankings, distribute rewards",
        "on_leave": "Remove participant, recalculate standings"
      }
    },
    "SF-005": {
      "name": "Notification Service",
      "description": "Push notifications and in-app messaging",
      "config": {
        "channels": ["push", "in_app", "email"],
        "categories": {
          "social": { "push": true, "in_app": true },
          "challenge": { "push": true, "in_app": true },
          "reminder": { "push": true, "in_app": false },
          "marketing": { "push": false, "in_app": true }
        },
        "quietHours": { "start": "22:00", "end": "08:00" }
      },
      "state_machine": {
        "states": ["created", "queued", "sent", "delivered", "read", "expired"],
        "transitions": {
          "created -> queued": "scheduled or immediate",
          "queued -> sent": "delivery attempted",
          "sent -> delivered": "device confirmed receipt",
          "delivered -> read": "user opened notification",
          "any -> expired": "TTL exceeded"
        }
      },
      "templates": {
        "meal_reminder": "점심시간이야! 한끼랑 같이 먹자 🍚",
        "streak_warning": "오늘 기록 안 하면 스트릭이... 🔥➡️💨",
        "challenge_start": "{challenge_name} 챌린지가 시작됐어요! 💪",
        "weekly_report": "이번 주 {xp}XP 획득! {rank}위 달성 🏆"
      }
    }
  },

