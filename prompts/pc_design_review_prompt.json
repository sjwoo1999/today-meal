    "review_process": {
        "step_1": {
            "name": "브라우저 창 크기 조정",
            "action": "1440px, 1280px, 1024px 너비에서 각각 스크린샷 캡처",
            "tools": [
                "browser_subagent",
                "capture_browser_screenshot"
            ]
        },
        "step_2": {
            "name": "각 페이지 순회",
            "pages": [
                "/ (홈 - 대시보드)",
                "/feed (피드)",
                "/record (식단 기록)",
                "/squad (스쿼드)",
                "/profile (마이페이지)"
            ],
            "action": "각 페이지에서 레이아웃, 컴포넌트, 상호작용 확인"
        },
        "step_3": {
            "name": "이슈 문서화",
            "action": "발견된 문제점을 severity (high/medium/low) 기준으로 정리"
        },
        "step_4": {
            "name": "수정 적용",
            "priority": "high > medium > low",
            "action": "CSS/컴포넌트 수정 후 재확인"
        }
    },
    "expected_output": {
        "screenshots": [
            "pc_home_1440px.png",
            "pc_home_1280px.png",
            "pc_home_1024px.png",
            "pc_feed_page.png",
            "pc_record_page.png",
            "pc_planner_page.png"
        ],
        "issue_report": {
            "format": "markdown",
            "sections": [
                "발견된 이슈",
                "수정 내용",
                "Before/After 비교"
            ]
        }
    },
    "priority_fixes": {
        "high": [
            "레이아웃 깨짐 (overflow, 요소 겹침)",
            "기능 동작 불가",
            "텍스트 잘림/가독성 문제"
        ],
        "medium": [
            "간격 불일치",
            "색상/스타일 불일치",
            "애니메이션 버벅임"
        ],
        "low": [
            "미세 정렬 조정",
            "호버 효과 개선",
            "아이콘 교체"
        ]
    },
    "notes_for_agent": [
        "PC 버전은 마우스/키보드 중심 UX 고려",
        "1024px 최소 너비에서 레이아웃 안정성 우선",
        "모바일과 동일한 기능이지만 정보 밀도 높게",
        "스크린샷 캡처 후 문제점 정리 → 수정 → 재확인 순서",
        "수정 시 기존 모바일 레이아웃 영향 없는지 확인"
    ]
