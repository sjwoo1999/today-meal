{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "meta": {
    "title": "OneMealToday 자동 테스트/시뮬레이션 프롬프트",
    "version": "1.0.0",
    "created": "2026-01-06",
    "language": "ko",
    "purpose": "전체 페이지 자동 시뮬레이션 및 테스트 수행을 위한 구조화된 프롬프트",
    "target_app": "OneMealToday (오늘한끼)",
    "framework": "Next.js 14 + React 18 + TypeScript"
  },

  "test_configuration": {
    "breakpoints": {
      "mobile": { "width": 375, "height": 812, "device": "iPhone 14" },
      "tablet": { "width": 768, "height": 1024, "device": "iPad" },
      "desktop": { "width": 1440, "height": 900, "device": "Desktop" }
    },
    "default_timeout": 5000,
    "screenshot_on_failure": true,
    "video_recording": false,
    "retry_count": 2,
    "base_url": "http://localhost:3000"
  },

  "state_mocking": {
    "stores": [
      {
        "name": "useUserStore",
        "initial_state": {
          "user": {
            "id": "test_user_1",
            "name": "테스트 사용자",
            "email": "test@example.com",
            "goal": "lose",
            "tdee": 1800,
            "gamification": { "xp": 1500, "level": 5, "streak": 7 }
          },
          "isAuthenticated": true
        }
      },
      {
        "name": "useUIStore",
        "initial_state": {
          "activeTab": "home",
          "showXPPopup": false,
          "celebrationModal": null
        }
      },
      {
        "name": "useFeedStore",
        "initial_state": {
          "posts": [],
          "feedState": "idle"
        }
      },
      {
        "name": "usePointStore",
        "initial_state": {
          "balance": { "available": 1500, "pending": 0, "total": 1500 }
        }
      },
      {
        "name": "useSquadStore",
        "initial_state": {
          "mySquads": [],
          "currentSquad": null
        }
      },
      {
        "name": "useChallengeStore",
        "initial_state": {
          "activeChallenges": [],
          "currentChallenge": null
        }
      }
    ],
    "mock_api_delay": 500
  },

  "pages": {
    "AUTH-001": {
      "id": "AUTH-001",
      "name": "SplashScreen",
      "path": "/",
      "component": "components/auth/SplashScreen.tsx",
      "description": "앱 시작 화면 - 로고 애니메이션 후 로그인/온보딩으로 이동",
      "preconditions": {
        "auth_state": "unauthenticated"
      },
      "test_cases": [
        {
          "id": "AUTH-001-TC01",
          "name": "스플래시 애니메이션 완료",
          "steps": [
            { "action": "wait", "target": "logo-animation", "timeout": 2000 },
            { "action": "verify", "target": "logo", "assertion": "visible" }
          ],
          "expected": "로고 애니메이션이 2초 내 완료됨"
        },
        {
          "id": "AUTH-001-TC02",
          "name": "자동 리다이렉트",
          "steps": [
            { "action": "wait", "duration": 3000 },
            { "action": "verify", "target": "url", "assertion": "contains", "value": "/login" }
          ],
          "expected": "3초 후 로그인 페이지로 이동"
        }
      ],
      "responsive_tests": ["mobile", "tablet", "desktop"]
    },

    "AUTH-002": {
      "id": "AUTH-002",
      "name": "LoginPage",
      "path": "/login",
      "component": "components/auth/LoginPage.tsx",
      "description": "소셜 로그인 페이지 (카카오, 네이버, 구글, 애플)",
      "preconditions": {
        "auth_state": "unauthenticated"
      },
      "test_cases": [
        {
          "id": "AUTH-002-TC01",
          "name": "소셜 로그인 버튼 렌더링",
          "steps": [
            { "action": "verify", "target": "[data-testid='kakao-login']", "assertion": "visible" },
            { "action": "verify", "target": "[data-testid='naver-login']", "assertion": "visible" },
            { "action": "verify", "target": "[data-testid='google-login']", "assertion": "visible" }
          ],
          "expected": "모든 소셜 로그인 버튼이 표시됨"
        },
        {
          "id": "AUTH-002-TC02",
          "name": "카카오 로그인 클릭",
          "steps": [
            { "action": "click", "target": "[data-testid='kakao-login']" },
            { "action": "wait", "target": "oauth-redirect", "timeout": 3000 }
          ],
          "expected": "카카오 OAuth 페이지로 리다이렉트"
        },
        {
          "id": "AUTH-002-TC03",
          "name": "회원가입 링크",
          "steps": [
            { "action": "click", "target": "[data-testid='signup-link']" },
            { "action": "verify", "target": "url", "assertion": "contains", "value": "/signup" }
          ],
          "expected": "회원가입 페이지로 이동"
        }
      ],
      "responsive_tests": ["mobile", "tablet", "desktop"]
    },

    "AUTH-003": {
      "id": "AUTH-003",
      "name": "SignupPage",
      "path": "/signup",
      "component": "components/auth/SignupPage.tsx",
      "description": "이메일 회원가입 페이지",
      "preconditions": {
        "auth_state": "unauthenticated"
      },
      "test_cases": [
        {
          "id": "AUTH-003-TC01",
          "name": "이메일 유효성 검사",
          "steps": [
            { "action": "type", "target": "[data-testid='email-input']", "value": "invalid-email" },
            { "action": "blur", "target": "[data-testid='email-input']" },
            { "action": "verify", "target": "[data-testid='email-error']", "assertion": "visible" }
          ],
          "expected": "유효하지 않은 이메일에 에러 메시지 표시"
        },
        {
          "id": "AUTH-003-TC02",
          "name": "비밀번호 강도 검사",
          "steps": [
            { "action": "type", "target": "[data-testid='password-input']", "value": "weak" },
            { "action": "verify", "target": "[data-testid='password-strength']", "assertion": "text", "value": "약함" },
            { "action": "clear", "target": "[data-testid='password-input']" },
            { "action": "type", "target": "[data-testid='password-input']", "value": "StrongP@ss123" },
            { "action": "verify", "target": "[data-testid='password-strength']", "assertion": "text", "value": "강함" }
          ],
          "expected": "비밀번호 강도에 따라 표시기 변경"
        },
        {
          "id": "AUTH-003-TC03",
          "name": "회원가입 성공",
          "steps": [
            { "action": "type", "target": "[data-testid='email-input']", "value": "newuser@test.com" },
            { "action": "type", "target": "[data-testid='password-input']", "value": "StrongP@ss123" },
            { "action": "type", "target": "[data-testid='password-confirm']", "value": "StrongP@ss123" },
            { "action": "click", "target": "[data-testid='signup-button']" },
            { "action": "wait", "target": "api-response", "timeout": 3000 },
            { "action": "verify", "target": "url", "assertion": "contains", "value": "/onboarding" }
          ],
          "expected": "회원가입 후 온보딩 페이지로 이동"
        }
      ],
      "responsive_tests": ["mobile", "tablet", "desktop"]
    },

    "AUTH-004": {
      "id": "AUTH-004",
      "name": "OnboardingPage",
      "path": "/onboarding",
      "component": "components/auth/OnboardingPage.tsx",
      "description": "사용자 온보딩 (4단계: 목표/신체정보/활동량/식이선호)",
      "preconditions": {
        "auth_state": "authenticated",
        "onboarding_completed": false
      },
      "test_cases": [
        {
          "id": "AUTH-004-TC01",
          "name": "Step 1: 목표 선택",
          "steps": [
            { "action": "verify", "target": "[data-testid='step-indicator']", "assertion": "text", "value": "1" },
            { "action": "click", "target": "[data-testid='goal-lose']" },
            { "action": "verify", "target": "[data-testid='goal-lose']", "assertion": "hasClass", "value": "border-green-500" },
            { "action": "click", "target": "[data-testid='next-button']" }
          ],
          "expected": "목표 선택 후 다음 단계로 이동"
        },
        {
          "id": "AUTH-004-TC02",
          "name": "Step 2: 신체 정보 입력",
          "steps": [
            { "action": "verify", "target": "[data-testid='step-indicator']", "assertion": "text", "value": "2" },
            { "action": "click", "target": "[data-testid='gender-male']" },
            { "action": "type", "target": "[data-testid='height-input']", "value": "175" },
            { "action": "type", "target": "[data-testid='weight-input']", "value": "70" },
            { "action": "type", "target": "[data-testid='age-input']", "value": "28" },
            { "action": "click", "target": "[data-testid='next-button']" }
          ],
          "expected": "신체 정보 입력 후 다음 단계로 이동"
        },
        {
          "id": "AUTH-004-TC03",
          "name": "Step 3: 활동량 선택",
          "steps": [
            { "action": "verify", "target": "[data-testid='step-indicator']", "assertion": "text", "value": "3" },
            { "action": "click", "target": "[data-testid='activity-moderate']" },
            { "action": "click", "target": "[data-testid='next-button']" }
          ],
          "expected": "활동량 선택 후 다음 단계로 이동"
        },
        {
          "id": "AUTH-004-TC04",
          "name": "Step 4: 식이 선호도 (선택사항)",
          "steps": [
            { "action": "verify", "target": "[data-testid='step-indicator']", "assertion": "text", "value": "4" },
            { "action": "click", "target": "[data-testid='tag-lowcarb']" },
            { "action": "click", "target": "[data-testid='next-button']" },
            { "action": "verify", "target": "url", "assertion": "contains", "value": "/home" }
          ],
          "expected": "온보딩 완료 후 홈 화면으로 이동"
        },
        {
          "id": "AUTH-004-TC05",
          "name": "데스크톱 키보드 네비게이션",
          "breakpoint": "desktop",
          "steps": [
            { "action": "click", "target": "[data-testid='goal-lose']" },
            { "action": "keyboard", "key": "Enter" },
            { "action": "verify", "target": "[data-testid='step-indicator']", "assertion": "text", "value": "2" },
            { "action": "keyboard", "key": "Escape" },
            { "action": "verify", "target": "[data-testid='step-indicator']", "assertion": "text", "value": "1" }
          ],
          "expected": "Enter로 다음 단계, Escape로 이전 단계"
        },
        {
          "id": "AUTH-004-TC06",
          "name": "건너뛰기 기능",
          "steps": [
            { "action": "click", "target": "[data-testid='skip-button']" },
            { "action": "verify", "target": "url", "assertion": "contains", "value": "/home" }
          ],
          "expected": "건너뛰기 클릭 시 홈으로 이동"
        }
      ],
      "responsive_tests": ["mobile", "tablet", "desktop"]
    },

    "MAIN-001": {
      "id": "MAIN-001",
      "name": "HomePage",
      "path": "/home",
      "tab_key": "home",
      "component": "components/HomePage.tsx",
      "description": "홈 대시보드 - 오늘 영양 현황, 퀘스트, 추천 메뉴",
      "preconditions": {
        "auth_state": "authenticated"
      },
      "test_cases": [
        {
          "id": "MAIN-001-TC01",
          "name": "영양 진행률 표시",
          "steps": [
            { "action": "verify", "target": "[data-testid='calorie-progress']", "assertion": "visible" },
            { "action": "verify", "target": "[data-testid='protein-progress']", "assertion": "visible" },
            { "action": "verify", "target": "[data-testid='carb-progress']", "assertion": "visible" }
          ],
          "expected": "칼로리/단백질/탄수화물 진행률 표시"
        },
        {
          "id": "MAIN-001-TC02",
          "name": "데일리 퀘스트 표시",
          "steps": [
            { "action": "verify", "target": "[data-testid='daily-quests']", "assertion": "visible" },
            { "action": "verify", "target": "[data-testid='quest-item']", "assertion": "count", "value": 3 }
          ],
          "expected": "데일리 퀘스트 3개 이상 표시"
        },
        {
          "id": "MAIN-001-TC03",
          "name": "한끼 마스코트 인사",
          "steps": [
            { "action": "verify", "target": "[data-testid='hanki-mascot']", "assertion": "visible" },
            { "action": "verify", "target": "[data-testid='hanki-greeting']", "assertion": "not-empty" }
          ],
          "expected": "한끼 마스코트와 인사말 표시"
        },
        {
          "id": "MAIN-001-TC04",
          "name": "식사 기록 버튼",
          "steps": [
            { "action": "click", "target": "[data-testid='record-meal-button']" },
            { "action": "verify", "target": "url", "assertion": "contains", "value": "/record" }
          ],
          "expected": "식사 기록 버튼 클릭 시 기록 페이지로 이동"
        }
      ],
      "states": {
        "loading": {
          "test": "skeleton_display",
          "assertions": ["칼로리 스켈레톤 표시", "퀘스트 스켈레톤 표시"]
        },
        "empty": {
          "test": "no_meals_today",
          "assertions": ["'아직 오늘 기록이 없어요' 메시지 표시", "기록하기 CTA 버튼 표시"]
        },
        "error": {
          "test": "api_failure",
          "assertions": ["에러 메시지 표시", "재시도 버튼 표시"]
        }
      },
      "responsive_tests": ["mobile", "tablet", "desktop"]
    },

    "MAIN-002": {
      "id": "MAIN-002",
      "name": "FeedPage",
      "path": "/feed",
      "tab_key": "feed",
      "component": "components/FeedPage.tsx",
      "description": "피드 페이지 - HOT 게시글, 최신 피드, 스토리",
      "preconditions": {
        "auth_state": "authenticated"
      },
      "test_cases": [
        {
          "id": "MAIN-002-TC01",
          "name": "스토리 바 표시",
          "steps": [
            { "action": "verify", "target": "[data-testid='story-bar']", "assertion": "visible" },
            { "action": "scroll", "target": "[data-testid='story-bar']", "direction": "horizontal" }
          ],
          "expected": "스토리 바가 가로 스크롤 가능"
        },
        {
          "id": "MAIN-002-TC02",
          "name": "HOT 게시글 캐러셀",
          "steps": [
            { "action": "verify", "target": "[data-testid='hot-posts']", "assertion": "visible" },
            { "action": "click", "target": "[data-testid='hot-post-card']:first-child" },
            { "action": "verify", "target": "[data-testid='post-detail']", "assertion": "visible" }
          ],
          "expected": "HOT 게시글 클릭 시 상세 페이지로 이동"
        },
        {
          "id": "MAIN-002-TC03",
          "name": "피드 새로고침",
          "steps": [
            { "action": "click", "target": "[data-testid='refresh-button']" },
            { "action": "verify", "target": "[data-testid='refresh-button']", "assertion": "hasClass", "value": "animate-spin" },
            { "action": "wait", "duration": 1000 },
            { "action": "verify", "target": "[data-testid='refresh-button']", "assertion": "not-hasClass", "value": "animate-spin" }
          ],
          "expected": "새로고침 버튼 클릭 시 로딩 애니메이션 후 피드 갱신"
        },
        {
          "id": "MAIN-002-TC04",
          "name": "포인트/알림 표시",
          "steps": [
            { "action": "verify", "target": "[data-testid='point-display']", "assertion": "visible" },
            { "action": "verify", "target": "[data-testid='notification-badge']", "assertion": "visible" }
          ],
          "expected": "헤더에 포인트와 알림 배지 표시"
        }
      ],
      "states": {
        "loading": {
          "test": "initial_load",
          "assertions": ["HOT 게시글 스켈레톤 표시", "피드 카드 스켈레톤 표시"]
        },
        "empty": {
          "test": "no_posts",
          "assertions": ["'팔로우한 사용자의 글이 없어요' 메시지", "탐색하기 CTA 버튼"]
        },
        "error": {
          "test": "api_failure",
          "assertions": ["에러 상태 컨테이너 표시", "재시도 버튼 활성화"]
        }
      },
      "responsive_tests": ["mobile", "tablet", "desktop"]
    },

    "MAIN-003": {
      "id": "MAIN-003",
      "name": "RecordPage",
      "path": "/record",
      "tab_key": "record",
      "component": "components/RecordPage.tsx",
      "description": "식사 기록 페이지 - 카메라/갤러리 선택, AI 분석, 영양 편집",
      "preconditions": {
        "auth_state": "authenticated"
      },
      "test_cases": [
        {
          "id": "MAIN-003-TC01",
          "name": "이미지 선택 옵션",
          "steps": [
            { "action": "verify", "target": "[data-testid='camera-button']", "assertion": "visible" },
            { "action": "verify", "target": "[data-testid='gallery-button']", "assertion": "visible" }
          ],
          "expected": "카메라와 갤러리 선택 버튼 표시"
        },
        {
          "id": "MAIN-003-TC02",
          "name": "AI 분석 로딩 상태",
          "steps": [
            { "action": "mock", "target": "file-input", "value": "test-food-image.jpg" },
            { "action": "verify", "target": "[data-testid='ai-analyzing']", "assertion": "visible" },
            { "action": "verify", "target": "[data-testid='analyzing-message']", "assertion": "text", "value": "AI가 음식을 분석 중이에요" }
          ],
          "expected": "이미지 업로드 시 AI 분석 로딩 표시"
        },
        {
          "id": "MAIN-003-TC03",
          "name": "인식 결과 표시",
          "steps": [
            { "action": "wait", "target": "[data-testid='recognition-result']", "timeout": 5000 },
            { "action": "verify", "target": "[data-testid='food-name']", "assertion": "not-empty" },
            { "action": "verify", "target": "[data-testid='calorie-estimate']", "assertion": "not-empty" }
          ],
          "expected": "AI 분석 완료 후 음식명과 칼로리 표시"
        },
        {
          "id": "MAIN-003-TC04",
          "name": "영양정보 수정",
          "steps": [
            { "action": "click", "target": "[data-testid='edit-nutrition-button']" },
            { "action": "clear", "target": "[data-testid='calorie-input']" },
            { "action": "type", "target": "[data-testid='calorie-input']", "value": "500" },
            { "action": "click", "target": "[data-testid='save-nutrition']" },
            { "action": "verify", "target": "[data-testid='calorie-display']", "assertion": "text", "value": "500" }
          ],
          "expected": "영양정보 수정 후 저장됨"
        },
        {
          "id": "MAIN-003-TC05",
          "name": "식사 시간 선택",
          "steps": [
            { "action": "click", "target": "[data-testid='meal-type-breakfast']" },
            { "action": "verify", "target": "[data-testid='meal-type-breakfast']", "assertion": "hasClass", "value": "selected" }
          ],
          "expected": "식사 시간 선택 가능"
        },
        {
          "id": "MAIN-003-TC06",
          "name": "기록 완료 및 포인트 획득",
          "steps": [
            { "action": "click", "target": "[data-testid='complete-record']" },
            { "action": "verify", "target": "[data-testid='xp-popup']", "assertion": "visible" },
            { "action": "verify", "target": "[data-testid='xp-amount']", "assertion": "text", "value": "+10" }
          ],
          "expected": "기록 완료 시 포인트 획득 팝업 표시"
        }
      ],
      "states": {
        "loading": {
          "test": "ai_analyzing",
          "assertions": ["분석 중 애니메이션 표시", "취소 버튼 활성화"]
        },
        "error": {
          "test": "recognition_failed",
          "assertions": ["'인식에 실패했어요' 메시지", "수동 입력 전환 버튼"]
        }
      },
      "responsive_tests": ["mobile", "tablet", "desktop"]
    },

