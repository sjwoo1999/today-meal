  "responsive_test_matrix": {
    "breakpoints": ["mobile", "tablet", "desktop"],
    "test_aspects": [
      {
        "aspect": "layout",
        "tests": [
          "navigation_type (bottom_nav vs sidebar)",
          "column_layout (1 vs 2 vs 3)",
          "modal_vs_sidepanel"
        ]
      },
      {
        "aspect": "interaction",
        "tests": [
          "touch_vs_hover",
          "swipe_gestures",
          "keyboard_navigation"
        ]
      },
      {
        "aspect": "typography",
        "tests": [
          "font_sizes",
          "line_heights",
          "text_truncation"
        ]
      },
      {
        "aspect": "images",
        "tests": [
          "responsive_images",
          "aspect_ratios",
          "lazy_loading"
        ]
      }
    ]
  },

  "state_test_scenarios": {
    "loading": {
      "description": "로딩 상태 테스트",
      "assertions": [
        "skeleton_displayed",
        "no_content_flash",
        "loading_indicator_visible"
      ]
    },
    "empty": {
      "description": "빈 상태 테스트",
      "assertions": [
        "empty_message_displayed",
        "action_cta_visible",
        "illustration_shown"
      ]
    },
    "error": {
      "description": "에러 상태 테스트",
      "assertions": [
        "error_message_displayed",
        "retry_button_visible",
        "error_details_available"
      ]
    },
    "offline": {
      "description": "오프라인 상태 테스트",
      "assertions": [
        "offline_banner_shown",
        "cached_data_displayed",
        "reconnect_indicator"
      ]
    }
  },

  "execution_instructions": {
    "setup": [
      "1. 개발 서버 실행 (npm run dev)",
      "2. 테스트 환경 변수 설정 (NEXT_PUBLIC_TEST_MODE=true)",
      "3. Mock 서버 활성화 (선택사항)",
      "4. 테스트 데이터베이스 초기화"
    ],
    "run_all": {
      "command": "npx playwright test",
      "description": "모든 테스트 실행"
    },
    "run_page": {
      "command": "npx playwright test --grep @{PAGE_ID}",
      "description": "특정 페이지 테스트 실행",
      "example": "npx playwright test --grep @MAIN-001"
    },
    "run_journey": {
      "command": "npx playwright test --grep @{JOURNEY_ID}",
      "description": "특정 User Journey 테스트 실행",
      "example": "npx playwright test --grep @UJ-001"
    },
    "run_responsive": {
      "command": "npx playwright test --project={breakpoint}",
      "description": "특정 브레이크포인트 테스트",
      "example": "npx playwright test --project=mobile"
    }
  },

  "reporting": {
    "formats": ["html", "json", "junit"],
    "output_dir": "./test-results",
    "screenshots": {
      "on_failure": true,
      "full_page": true
    },
    "video": {
      "enabled": false,
      "on_failure": true
    },
    "trace": {
      "enabled": true,
      "on_failure": true
    }
  }
