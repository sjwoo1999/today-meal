  "design_principles": {
    "core_principles": [
      {
        "name": "Clarity (명료성)",
        "description": "사용자가 한눈에 현재 상태와 다음 행동을 파악할 수 있어야 함",
        "implementation": [
          "주요 정보 계층 명확화 (제목 > 핵심 수치 > 보조 정보)",
          "CTA 버튼은 화면당 1-2개로 제한",
          "상태 표시는 색상 + 아이콘 + 텍스트 조합"
        ]
      },
      {
        "name": "Breathing Room (여유)",
        "description": "충분한 여백으로 시각적 휴식 공간 제공",
        "implementation": [
          "요소 간 최소 간격: 16px",
          "카드 내부 패딩: 20-24px",
          "섹션 간 간격: 24-32px"
        ]
      },
      {
        "name": "Progressive Disclosure (점진적 노출)",
        "description": "필요한 정보만 단계별로 노출",
        "implementation": [
          "홈 화면: 핵심 상태만 표시",
          "상세 정보는 탭/클릭으로 확장",
          "고급 설정은 깊은 depth에 배치"
        ]
      },
      {
        "name": "Emotional Connection (정서적 연결)",
        "description": "한끼 마스코트를 통한 감정적 교류",
        "implementation": [
          "한끼의 감정 상태를 미묘하게 표현",
          "성취 시 즐거운 축하 애니메이션",
          "실패 시 따뜻한 격려 메시지"
        ]
      },
      {
        "name": "Consistency (일관성)",
        "description": "모든 화면에서 동일한 디자인 언어 사용",
        "implementation": [
          "디자인 토큰 시스템 철저 적용",
          "컴포넌트 재사용률 높이기",
          "동일 기능 = 동일 패턴"
        ]
      }
    ]
  },

