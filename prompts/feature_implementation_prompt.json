  "tasks": [
    {
      "id": "TASK-001",
      "title": "AI 음식 인식결과 페이지 구현",
      "priority": "high",
      "category": "feature",
      "description": "식사 기록 플로우에서 AI가 음식을 분석한 후 결과를 보여주는 전용 페이지/컴포넌트 구현",

      "user_flow": {
        "sequence": [
          "1. 사용자가 카메라/갤러리에서 음식 이미지 선택",
          "2. AI 분석 중 로딩 상태 표시 (ai-analyzing)",
          "3. 분석 완료 후 인식결과 페이지로 전환",
          "4. 사용자가 결과 확인/수정 후 저장"
        ],
        "entry_points": [
          "RecordPage → 이미지 선택 → 분석 중 → 인식결과",
          "FoodRecordFlow 컴포넌트 내부 단계"
        ]
      },

      "requirements": {
        "ui_components": [
          {
            "name": "RecognitionResultPage",
            "path": "app/src/components/record/RecognitionResultPage.tsx",
            "description": "AI 인식결과 메인 페이지 컴포넌트",
            "features": [
              "인식된 음식 이미지 썸네일",
              "음식명 및 신뢰도 표시",
              "영양정보 (칼로리, 단백질, 탄수화물, 지방)",
              "수정 버튼 (음식명, 영양정보)",
              "식사 타입 선택 (아침/점심/저녁/간식)",
              "저장 버튼"
            ]
          },
          {
            "name": "NutritionEditModal",
            "path": "app/src/components/record/NutritionEditModal.tsx",
            "description": "영양정보 수정 모달",
            "features": [
              "각 영양소별 숫자 입력",
              "단위 표시 (kcal, g)",
              "저장/취소 버튼"
            ]
          },
          {
            "name": "FoodNameEditModal",
            "path": "app/src/components/record/FoodNameEditModal.tsx",
            "description": "음식명 수정 모달",
            "features": [
              "텍스트 입력 필드",
              "최근 검색어 추천",
              "저장/취소 버튼"
            ]
          }
        ],

        "data_testid_attributes": [
          "recognition-result: 인식결과 페이지 컨테이너",
          "recognized-food-image: 인식된 음식 이미지",
          "recognized-food-name: 인식된 음식명",
          "confidence-score: AI 신뢰도 점수",
          "nutrition-calories: 칼로리 표시",
          "nutrition-protein: 단백질 표시",
          "nutrition-carbs: 탄수화물 표시",
          "nutrition-fat: 지방 표시",
          "edit-food-name-button: 음식명 수정 버튼",
          "edit-nutrition-button: 영양정보 수정 버튼",
          "meal-type-selector: 식사 타입 선택",
          "save-record-button: 저장 버튼",
          "cancel-button: 취소 버튼"
        ],

        "mock_data": {
          "recognized_foods": [
            {
              "id": "food_001",
              "name": "김치찌개",
              "confidence": 0.94,
              "nutrition": {
                "calories": 180,
