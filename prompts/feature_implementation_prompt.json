        "states": {
          "loading": {
            "description": "AI 분석 중 상태",
            "ui": "스켈레톤 + 분석 중 애니메이션",
            "duration": "2-5초"
          },
          "success": {
            "description": "인식 성공",
            "ui": "결과 표시 + 수정/저장 버튼"
          },
          "low_confidence": {
            "description": "낮은 신뢰도 (< 70%)",
            "ui": "경고 메시지 + 수동 입력 권장"
          },
          "failed": {
            "description": "인식 실패",
            "ui": "에러 메시지 + 재시도/수동 입력 버튼"
          }
        }
      },

      "integration": {
        "modify_files": [
          {
            "path": "app/src/components/RecordPage.tsx",
            "changes": "인식결과 컴포넌트 연동"
          },
          {
            "path": "app/src/components/record/FoodRecordFlow.tsx",
            "changes": "인식결과 단계 추가"
          }
        ],
        "store_updates": [
          {
            "store": "useMealStore 또는 useRecordStore",
            "new_state": "recognitionResult, isAnalyzing, analysisError"
          }
        ]
      }
    },

