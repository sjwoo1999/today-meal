                "fat": 10
              },
              "imageUrl": "/images/foods/kimchi-jjigae.jpg"
            },
            {
              "id": "food_002",
              "name": "비빔밥",
              "confidence": 0.89,
              "nutrition": {
                "calories": 520,
                "protein": 15,
                "carbs": 85,
                "fat": 12
              },
              "imageUrl": "/images/foods/bibimbap.jpg"
            },
            {
              "id": "food_003",
