  "code_examples": {
    "useBreakpoint_integration": {
      "language": "typescript",
      "code": "import { useBreakpoint } from '@/hooks/useBreakpoint';\n\nexport default function OnboardingPage() {\n  const { isMobile, isTablet, isDesktop } = useBreakpoint();\n  \n  if (isDesktop) {\n    return <OnboardingDesktopLayout {...props} />;\n  }\n  \n  return <OnboardingMobileLayout {...props} />;\n}"
    },

    "desktop_layout_structure": {
      "language": "tsx",
      "code": "<div className=\"min-h-screen flex\">\n  {/* Left Panel - Branding */}\n  <div className=\"hidden lg:flex w-1/2 bg-gradient-to-br from-coral-50 to-sage-50 p-12 flex-col justify-center items-center\">\n    <OnboardingProgressSidebar currentStep={step} />\n    <div className=\"mt-8\">\n      <StepIllustration step={step} />\n    </div>\n  </div>\n  \n  {/* Right Panel - Form */}\n  <div className=\"w-full lg:w-1/2 flex items-center justify-center p-8\">\n    <div className=\"w-full max-w-md\">\n      {children}\n    </div>\n  </div>\n</div>"
    },

    "responsive_goal_step": {
      "language": "tsx",
      "code": "<div className={`grid gap-4 ${isDesktop ? 'grid-cols-3' : 'grid-cols-1'}`}>\n  {goals.map((goal) => (\n    <motion.button\n      key={goal.id}\n      onClick={() => handleSelect(goal.id)}\n      className={`p-6 rounded-2xl border-2 transition-all\n        ${isDesktop ? 'aspect-square flex-col' : 'flex-row'}\n        ${selected === goal.id ? 'border-coral-500 bg-coral-50' : 'border-gray-200'}`}\n    >\n      <span className=\"text-3xl\">{goal.emoji}</span>\n      <span className=\"font-bold\">{goal.label}</span>\n    </motion.button>\n  ))}\n</div>"
    }
